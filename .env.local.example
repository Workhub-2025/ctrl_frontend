# NextAuth session jar (still used with Firebase Auth sessions)
NEXTAUTH_SECRET=your-super-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
# Enable only after client and hiring-manager users have been notified that
# their next sign-in will require authenticator enrolment.
REQUIRE_PORTAL_MFA_ENROLLMENT=false

# Firebase web application (public identifiers).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ctrl-assess.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ctrl-assess
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ctrl-assess.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=765430607081
NEXT_PUBLIC_FIREBASE_APP_ID=1:765430607081:web:eede2900e1648ffb981478

# Private Function invocation through Vercel OIDC -> Google WIF.
FIREBASE_DOMAIN_API_URL=https://europe-west2-ctrl-assess.cloudfunctions.net/domainApi
GOOGLE_WORKLOAD_IDENTITY_PROVIDER=//iam.googleapis.com/projects/765430607081/locations/global/workloadIdentityPools/ctrl-staging-vercel/providers/vercel
GOOGLE_SERVICE_ACCOUNT_EMAIL=ctrl-staging-vercel-invoker@ctrl-assess.iam.gserviceaccount.com
# Pull the short-lived local VERCEL_OIDC_TOKEN with `vercel env pull`.

# Optional Stripe (server-only). Prefer Function webhook + Secret Manager in staging/prod.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development Settings
NODE_ENV=development
