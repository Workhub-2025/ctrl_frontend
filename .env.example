# Environment variables for ctrl_frontend (Next.js 15)
# Copy this file to .env.local and fill in the actual values.
# Firebase-only: Strapi/CMS variables are retired and must not be set.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# ── NextAuth session jar (still used with Firebase Auth sessions) ─────────────
# NEXTAUTH_URL must match the exact origin used in the browser.
# Production: https://ctrl-assess.co.uk
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ── Upstash (recommended for production) ─────────────────────────────────────
# Shared login lockout, rate limits, and portal server read cache.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional session tuning (seconds)
# SESSION_MAX_AGE_SECONDS=43200
# SESSION_IDLE_MAX_AGE_SECONDS=1800

# ── Firebase web app ──────────────────────────────────────────────────────────
# Public Firebase web identifiers. Add the matching values to Vercel for each
# environment. Analytics remains disabled until consent and policy are updated.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ctrl-assess.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ctrl-assess
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ctrl-assess.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=765430607081
NEXT_PUBLIC_FIREBASE_APP_ID=1:765430607081:web:eede2900e1648ffb981478
NEXT_PUBLIC_AUTH_PROVIDER=firebase

# Private Firebase Function transport (server-side only).
FIREBASE_DOMAIN_API_URL=https://europe-west2-ctrl-assess.cloudfunctions.net/domainApi
GOOGLE_WORKLOAD_IDENTITY_PROVIDER=//iam.googleapis.com/projects/765430607081/locations/global/workloadIdentityPools/ctrl-staging-vercel/providers/vercel
GOOGLE_SERVICE_ACCOUNT_EMAIL=ctrl-staging-vercel-invoker@ctrl-assess.iam.gserviceaccount.com
# VERCEL_OIDC_TOKEN is supplied by Vercel. For local development use
# `vercel env pull`; never paste a service-account JSON key into this file.

# Migration gate for client and hiring-manager MFA. Leave false while accounts
# are being introduced to self-service enrolment, then enable in production.
# Candidates and administrators are not forced by this flag.
REQUIRE_PORTAL_MFA_ENROLLMENT=false

# ── Deployment flags ─────────────────────────────────────────────────────────
# Do not set CLOUDFLARE_PAGES. Static export is incompatible with the
# NextAuth/route-handler/middleware BFF architecture and now fails the build.

# ── Stripe billing ─────────────────────────────────────────────────────────────
# Secret key — required to create Checkout sessions (admin send-invoice / renewals).
# Prefer Stripe test keys on Preview; live keys only on Production when ready.
STRIPE_SECRET_KEY=sk_test_...
# Prefer the dedicated Cloud Function webhook
# (https://europe-west2-ctrl-assess.cloudfunctions.net/stripeWebhook) with
# STRIPE_WEBHOOK_SECRET in Google Secret Manager. The BFF route only needs a
# local whsec when forwarding events through WIF during development:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: reuse a fixed Customer Portal configuration.
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...
# Public app URL for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── UK legal/compliance (public values; required for a live production build) ──
# Production startup emits a high-severity readiness warning when these are missing.
# For non-live previews only, ALLOW_INCOMPLETE_UK_COMPLIANCE=true labels the warning
# as an acknowledged preview exception.
NEXT_PUBLIC_CTRL_COMPANY_NUMBER=
NEXT_PUBLIC_CTRL_REGISTERED_OFFICE=
NEXT_PUBLIC_CTRL_REGISTRATION_JURISDICTION="England and Wales"
NEXT_PUBLIC_CTRL_ICO_NUMBER=
NEXT_PUBLIC_DEFAULT_ASSESSMENT_DATA_RETENTION_MONTHS=
NEXT_PUBLIC_CTRL_FRONTEND_HOST=
NEXT_PUBLIC_CTRL_FRONTEND_HOST_LOCATION=
NEXT_PUBLIC_CTRL_BACKEND_HOST=
NEXT_PUBLIC_CTRL_BACKEND_HOST_LOCATION=
NEXT_PUBLIC_CTRL_UPSTASH_LOCATION=
NEXT_PUBLIC_CTRL_EMAIL_PROVIDER=
NEXT_PUBLIC_CTRL_EMAIL_PROVIDER_LOCATION=
NEXT_PUBLIC_CTRL_AI_PROVIDER=
NEXT_PUBLIC_CTRL_AI_PROVIDER_LOCATION=
# ALLOW_INCOMPLETE_UK_COMPLIANCE=true
